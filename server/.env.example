# Server environment configuration — copy to server/.env and fill in real values.
# server/.env is gitignored and must never be committed (it holds live secrets).

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key — SECRET. Bypasses all RLS. Server-side only. Never expose to the client.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Port the API server listens on
PORT=3001

# Allowed CORS origin (the front-end URL). Required in production.
CORS_ORIGIN=http://localhost:3000

# Node environment: development | production
NODE_ENV=development
